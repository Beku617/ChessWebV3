# Frontend API base URL
VITE_API_URL=http://localhost:3001

# Google OAuth (backend, used to verify Google ID tokens)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook OAuth (backend token verification guard)
FACEBOOK_APP_ID=your-facebook-app-id

# Cookie signature secret (required in production)
COOKIE_SECRET=replace-with-long-random-secret

# Email verification toggle (disabled by default for now; set to true to re-enable)
EMAIL_VERIFICATION_REQUIRED=false

# Email verification via Gmail SMTP (only required when EMAIL_VERIFICATION_REQUIRED=true)
SMTP_GMAIL_USER=youremail@gmail.com
SMTP_GMAIL_APP_PASSWORD=your-gmail-app-password
# Optional sender address (defaults to SMTP_GMAIL_USER)
EMAIL_FROM=youremail@gmail.com
# Optional verification behavior (defaults: 10 min ttl, 60 sec resend cooldown)
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Backend database
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>

# Cloudinary media storage (required for image/video uploads)
CLOUDINARY_CLOUD_NAME=dkouurnny
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional Cloudinary folder root (defaults to "neongambit")
CLOUDINARY_UPLOAD_FOLDER=neongambit
