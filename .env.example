# Frontend API base URL
VITE_API_URL=http://localhost:3001

# Google OAuth (backend, used to verify Google ID tokens)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Facebook OAuth (backend token verification guard)
FACEBOOK_APP_ID=your-facebook-app-id

# Cookie signature secret (required in production)
COOKIE_SECRET=replace-with-long-random-secret

# Backend database
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>

# Cloudinary media storage (required for image/video uploads)
CLOUDINARY_CLOUD_NAME=dkouurnny
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional Cloudinary folder root (defaults to "neongambit")
CLOUDINARY_UPLOAD_FOLDER=neongambit
